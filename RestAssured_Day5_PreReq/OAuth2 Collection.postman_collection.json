    {
      "name": "Access Token APIs",
      "item": [
        {
          "name": "Generate Access Token Using Password Grant Type - We Re-Authenticate Authentication Server",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const responseBody = pm.response.json();\npm.globals.set(\"accessToken\", responseBody.accessToken);\npm.globals.set(\"refreshToken\", responseBody.refreshToken);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "grant_type",
                  "value": "password"
                },
                {
                  "key": "client_id",
                  "value": "employee_client"
                },
                {
                  "key": "client_secret",
                  "value": "employee_secret"
                },
                {
                  "key": "username",
                  "value": "Sai"
                },
                {
                  "key": "password",
                  "value": "Sai123"
                },
                {
                  "key": "scope",
                  "value": "read write"
